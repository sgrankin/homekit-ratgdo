--- /dev/null
+++ b/src/homekit_event_queue.h
@@ -0,0 +1,102 @@
+// Local RATGDO patch: bounded ownership of pending HomeKit notifications.
+#pragma once
+#include <stdlib.h>
+#include <string.h>
+#include <homekit/types.h>
+#include "cQueue.h"
+
+typedef struct {
+    homekit_characteristic_t *characteristic;
+    homekit_value_t value;
+} characteristic_event_t;
+
+// Unlike the upstream void copy helper, propagate allocation failure. Values
+// are copied before replacing an existing notification so failure preserves it.
+static inline bool homekit_event_copy_value(homekit_value_t *dst, homekit_value_t *src) {
+    *dst = *src;
+    if (src->is_null || src->is_static)
+        return true;
+    switch (src->format) {
+    case homekit_format_string:
+        dst->string_value = strdup(src->string_value);
+        return dst->string_value != NULL;
+    case homekit_format_data:
+        dst->data_value = src->data_size ? (uint8_t *)malloc(src->data_size) : NULL;
+        if (src->data_size && !dst->data_value)
+            return false;
+        if (src->data_size)
+            memcpy(dst->data_value, src->data_value, src->data_size);
+        return true;
+    case homekit_format_tlv: {
+        dst->tlv_values = (tlv_values_t *)calloc(1, sizeof(tlv_values_t));
+        if (!dst->tlv_values)
+            return false;
+        tlv_t **tail = &dst->tlv_values->head;
+        for (tlv_t *item = src->tlv_values->head; item; item = item->next) {
+            tlv_t *copy = (tlv_t *)calloc(1, sizeof(tlv_t));
+            if (!copy) {
+                homekit_value_destruct(dst);
+                return false;
+            }
+            *tail = copy;
+            tail = &copy->next;
+            copy->type = item->type;
+            copy->size = item->size;
+            if (item->size) {
+                copy->value = (uint8_t *)malloc(item->size);
+                if (!copy->value) {
+                    homekit_value_destruct(dst);
+                    return false;
+                }
+                memcpy(copy->value, item->value, item->size);
+            }
+        }
+        return true;
+    }
+    default:
+        return true; // scalar value, no heap ownership
+    }
+}
+
+static inline void homekit_event_destroy(characteristic_event_t *event) {
+    homekit_value_destruct(&event->value);
+    free(event);
+}
+
+static inline void homekit_event_queue_clear(Queue_t *queue) {
+    characteristic_event_t *event;
+    while (q_pop(queue, &event))
+        homekit_event_destroy(event);
+}
+
+// Caller disconnects on failure: dropping a distinct characteristic silently
+// could leave a controller with stale state. Reconnection obtains a fresh snapshot.
+static inline bool homekit_event_enqueue(Queue_t *queue,
+        homekit_characteristic_t *ch, homekit_value_t *value) {
+    characteristic_event_t *event;
+    for (uint16_t i = 0; i < q_getCount(queue); ++i) {
+        if (q_peekIdx(queue, &event, i) && event->characteristic == ch) {
+            homekit_value_t replacement;
+            if (!homekit_event_copy_value(&replacement, value))
+                return false;
+            homekit_value_destruct(&event->value);
+            event->value = replacement;
+            return true;
+        }
+    }
+    if (q_isFull(queue))
+        return false;
+    event = (characteristic_event_t *)malloc(sizeof(*event));
+    if (!event)
+        return false;
+    event->characteristic = ch;
+    if (!homekit_event_copy_value(&event->value, value)) {
+        free(event);
+        return false;
+    }
+    if (!q_push(queue, &event)) {
+        homekit_event_destroy(event);
+        return false;
+    }
+    return true;
+}
